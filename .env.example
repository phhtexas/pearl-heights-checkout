# Copy names only. Oscar enters real values in Vercel → Project → Settings → Environment Variables.
DATABASE_URL=
HOSPITABLE_API_TOKEN=
STRIPE_SECRET_KEY=          # test mode first (sk_test_...)
STRIPE_PUBLISHABLE_KEY=     # pk_test_...
STRIPE_WEBHOOK_SECRET=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=bookings@pearlheightshomes.com
GA4_MEASUREMENT_ID=G-CWJ10Z81C4
META_PIXEL_ID=761704693497474
META_CAPI_TOKEN=
CHECKOUT_MODE=mock          # mock | test | live
# Tracking (Nov 18). Public IDs (not secrets); trackers load only after the visitor accepts cookies.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# Meta Conversions API (server booking event). Secret: Oscar adds it in Vercel only.
META_CAPI_TOKEN=
# Optional: Meta Events Manager > Test events code. With it, test-mode bookings are sent there (never to real reporting).
META_TEST_EVENT_CODE=

# Search engines: "on" lets Google/Bing/AI search index pearlheightshomes.com (redeploy after changing). Off until launch.
SITE_INDEXING=

# Booking texts (Twilio). Off unless GUEST_TEXTS=on. TWILIO_FROM = verified toll-free number, +1XXXXXXXXXX.
GUEST_TEXTS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Booking confirmation email (Resend). Off unless GUEST_EMAILS=on. Verify pearlheightshomes.com in Resend first.
GUEST_EMAILS=
RESEND_API_KEY=
# Optional; defaults to "Pearl Heights Homes <bookings@pearlheightshomes.com>"
EMAIL_FROM=
# Public site address used in links sent by the maintenance cron (reminders, notices). Default https://pearlheightshomes.com
PUBLIC_ORIGIN=

# Guest chat (stay page) and host inbox (/host). Alerts for new guest messages go by email to HOST_ALERT_EMAIL
# (default bookings@) and, with HOST_TEXT_ALERTS=on, by text to HOST_ALERT_PHONE (server-only; Twilio settings above).
# HOST_EMAILS = addresses allowed to sign in to the inbox (comma-separated; default bookings@pearlheightshomes.com).
HOST_ALERT_EMAIL=
HOST_TEXT_ALERTS=
HOST_ALERT_PHONE=
HOST_EMAILS=
